# Plantilla de credenciales para marimo_lab.
#
# Copiala a `.env` en este mismo directorio y completa los valores:
#
#     cp .env.example .env
#
# `.env` esta en .gitignore y NO debe commitearse nunca. Este archivo, en
# cambio, si se versiona: solo contiene nombres de variable, sin valores.

# -----------------------------------------------------------------------------
# Base de datos SQL Server  --  requerido por sentiance_data_explorer.py
# -----------------------------------------------------------------------------
# El explorador aborta con un aviso si falta cualquiera de las cuatro primeras.
# Necesitas acceso de red al servidor: si esta detras de VPN, conectate antes
# de abrir el notebook.

DB_SERVER=servidor.dominio.com
DB_NAME=NombreDeLaBaseDeDatos
DB_USER=usuario_sql
DB_PASS=contrasena

# Puerto de SQL Server. El estandar es 1433, pero esta instalacion usa 9433.
# Si se omite, el notebook asume 9433.
DB_PORT=9433

# -----------------------------------------------------------------------------
# OpenRouter  --  requerido solo por sentiance_analyzer_ia.py
# -----------------------------------------------------------------------------
# No hace falta para el explorador de datos. Se obtiene en
# https://openrouter.ai/keys y el uso se factura por token.

OPENROUTER_API_KEY=
